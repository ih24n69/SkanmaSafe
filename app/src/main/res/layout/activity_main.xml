<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_gradient">

    <!-- Greeting Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
		android:layout_marginTop="16dp">

		<!-- Icon Mata / Bulan -->
		<ImageView
			android:id="@+id/greetingIcon"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:src="@drawable/ic_sun"
			android:layout_alignParentStart="true"
			android:layout_alignParentTop="true" />

		<!-- Greeting Text -->
		<TextView
			android:id="@+id/tvGreeting"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Hay, Selamat Pagi !"
			android:textSize="20sp"
			android:textStyle="bold"
			android:textColor="#FFFFFF"
			android:layout_below="@id/greetingIcon"
			android:layout_alignStart="@id/greetingIcon"
			android:layout_marginTop="4dp"/>

		<!-- Sub Greeting Text -->
		<TextView
			android:id="@+id/tvSubGreeting"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Selamat Datang di SMK Negeri 5 Sukoharjo"
			android:textSize="14sp"
			android:textColor="#FFFFFF"
			android:layout_below="@id/tvGreeting"
			android:layout_alignStart="@id/tvGreeting"
			android:layout_marginTop="2dp"/>

        <!-- Gambar Sekolah / Tidur -->
        <ImageView
            android:id="@+id/greetingImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/school_day" />
    </RelativeLayout>

    <!-- Logo Sekolah -->
    <ImageView
        android:layout_marginTop="30dp"
        android:id="@+id/logoImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_smk5"
        android:layout_marginBottom="16dp" />

	<Button
		android:layout_marginTop="60dp"
		android:id="@+id/btnMulaiUjian"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/rounded_button"
		android:textColor="#FFFFFF"
		android:text="Mulai Ujian" 
		android:layout_marginBottom="12dp"/>
	
	<Button
		android:id="@+id/btnInputLink"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/rounded_button"
		android:textColor="#FFFFFF"
		android:text="Masukkan Tautan" 
		android:layout_marginBottom="12dp"/>

	<Button
		android:id="@+id/btnPeraturan"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/rounded_button"
		android:textColor="#FFFFFF"
		android:text="Peraturan Ujian" 
		android:layout_marginBottom="12dp"/>

	<Button
		android:id="@+id/btnAbout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/rounded_button"
		android:textColor="#FFFFFF"
		android:text="Tentang Aplikasi" 
		android:layout_marginBottom="12dp"/>
</LinearLayout>
