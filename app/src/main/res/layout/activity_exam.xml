<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

		<!-- STATUS BAR CUSTOM -->
    	<LinearLayout
		android:id="@+id/statusBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:padding="8dp"
		android:background="#222"
		android:gravity="center_vertical"
		android:elevation="4dp">

		<!-- Jam realtime di kiri -->
		<TextView
			android:id="@+id/tvClock"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="00:00"
			android:textColor="@android:color/white"
			android:textSize="16sp"
			android:layout_gravity="center_vertical" />

		<!-- Space untuk mempush elemen lain ke kanan -->
		<Space
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1" />

		<!-- Ikon koneksi -->
		<ImageView
			android:id="@+id/statusIcon"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_signal_good"
			android:layout_gravity="center_vertical"
			android:layout_marginEnd="4dp" />

		<!-- Teks status koneksi -->
		<TextView
			android:id="@+id/statusText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Koneksi bagus"
			android:textColor="#FFFFFF"
			android:textSize="14sp"
			android:layout_gravity="center_vertical"
			android:layout_marginEnd="8dp" />

		<!-- Ikon baterai -->
		<ImageView
			android:id="@+id/ivBattery"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_battery_full"
			android:tint="@android:color/white"
			android:layout_gravity="center_vertical"
			android:layout_marginEnd="4dp" />

		<!-- Persentase baterai -->
		<TextView
			android:id="@+id/tvBattery"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="100%"
			android:textColor="@android:color/white"
			android:textSize="16sp"
			android:layout_gravity="center_vertical" />
	</LinearLayout>

    <!-- WEBVIEW UTAMA -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/statusBar"/>

    <!-- FAB MENU MELAYANG -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="50dp"
        android:src="@drawable/ic_menu"
        android:contentDescription="Menu"
        app:backgroundTint="@color/bg_menu_fab"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRefresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp"
        android:src="@drawable/ic_refresh"
        android:contentDescription="Refresh"
        android:visibility="gone"
        app:backgroundTint="@color/teal_200"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="120dp"
        android:src="@drawable/ic_exit"
        android:contentDescription="Exit"
        android:visibility="gone"
        app:backgroundTint="@color/red"/>

</RelativeLayout>
